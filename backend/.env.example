# Eh?Bot Dashboard API — Environment Variables
# คัดลอกไฟล์นี้เป็น .env แล้วแก้ไขค่าให้ถูกต้อง

# Supabase Project URL (เช่น https://xxxxxxxxxxxx.supabase.co)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Service Role Key (ไม่ใช่ anon key — ใช้ service_role เพื่อ bypass RLS)
SUPABASE_SERVICE_KEY=your-service-role-key-here

# Gemini embedding for Dataset comparison and approval; server-side only.
# Set in backend/.env or the server environment, never in VITE_* variables.
GEMINI_API_KEY=

# Dashboard access password/token: enter in the dashboard when prompted.
# Never put the Supabase service key in VITE_* variables.
DASHBOARD_API_TOKEN=replace-with-a-long-random-secret

# Allowed frontend origins, separated by commas. Localhost is always included.
# Use origins only (no path); wildcard (*) is not supported. Restart after changes.
DASHBOARD_WEB_ORIGINS=https://your-frontend.onrender.com
