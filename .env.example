# Development uses the Vite /api proxy to localhost:8000.
# Production: set to the HTTPS dashboard API URL, or keep /api behind a reverse proxy.
VITE_API_URL=/api

# Public LIFF ID; must match MINI_LIFF_ID on the bot server.
# Endpoint URL in LINE Developers: https://your-frontend.example/mini/result
VITE_MINI_LIFF_ID=
# Bot API origin only, e.g. https://your-bot-api.example (not Dashboard API).
# Empty uses the Vite /api/mini proxy locally, or a same-origin reverse proxy.
VITE_MINI_API_BASE_URL=
# Optional public frontend origin: Vite allows only this hostname for a dev tunnel.
MINI_WEB_ORIGIN=
